# ---------- Odoo (solo servidor, configurar en Vercel → Settings → Environment Variables) ----------
# mock: no envía nada, solo registra en los logs (por defecto, ideal para probar)
# jsonrpc: API externa clásica (Odoo 17–19)   ·   json2: API JSON-2 de Odoo 19+
ODOO_MODE=mock
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tuempresa
ODOO_LOGIN=usuario-tecnico@bizitglobal.com
ODOO_API_KEY=
# Opcionales
ODOO_TEAM_ID=
ODOO_TAG_IDS=
# Campos personalizados de crm.lead (creados con Studio), por ejemplo:
# ODOO_FIELD_MAP={"score":"x_studio_puntaje","level":"x_studio_nivel_ia","game":"x_studio_juego","pain":"x_studio_dolor"}
ODOO_FIELD_MAP=

# Clave simple compartida kiosco ↔ API (evita envíos de terceros). Mismo valor en ambas.
LEADS_KIOSK_KEY=
NEXT_PUBLIC_KIOSK_KEY=

# ---------- Kiosco ----------
# Juegos habilitados (cuando Comercial elija, dejar uno solo: el selector desaparece)
NEXT_PUBLIC_GAMES=compania,deploy,central
NEXT_PUBLIC_CAMPAIGN=Expo IA 2026
NEXT_PUBLIC_CTA_URL=https://bgenai.bizitglobal.com/

# ---------- Desarrollo ----------
# Arranca directo en un juego con barra de desarrollo (comenzar / pausar / reiniciar / saltar fase).
# compania | deploy | central | off. En .env.development ya viene en "compania" para `npm run dev`;
# en Vercel dejarlo vacío u "off" (o forzarlo por URL con ?dev=compania en una preview).
NEXT_PUBLIC_DEV_GAME=off
